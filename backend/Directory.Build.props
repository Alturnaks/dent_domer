<Project>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <!-- Уязвимости транзитивных пакетов видны как предупреждения, но не ломают restore (закрываем пинами в Directory.Packages.props) -->
    <WarningsNotAsErrors>$(WarningsNotAsErrors);NU1901;NU1902;NU1903;NU1904;NU1608;NU1603</WarningsNotAsErrors>
    <NuGetAuditMode>direct</NuGetAuditMode>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <EnforceCodeStyleInBuild>false</EnforceCodeStyleInBuild>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <InvariantGlobalization>false</InvariantGlobalization>
    <!-- CA1848/CA1873 (LoggerMessage), CA2007 (ConfigureAwait) и CA1062 не нужны для ASP.NET Core-приложения -->
    <NoWarn>$(NoWarn);CA1000;CA1725;CA1848;CA1873;CA2007;CA1062;CA1711;CA1716;CA1720;CA1724;CA1034;CA1819;CA2227;CA1002;CA1056;CA1054;CA1055;CA1305;CA1307;CA1309;CA1310;CA1304;CA1311;CA1308;CA1862;CA1812;CA1515;CA1852;CA1822;CA2000;CA1031;CA5394;CA1515;CA1861;CA1851;CA1859;CA1805;CA1508;CA2201;CA1869;CA1027;CA1008;CA1028;CA1707;CA1303;CA1822;CA2234;CA1865;CA1866;CA1867</NoWarn>
  </PropertyGroup>
</Project>
