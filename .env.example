# Скопируйте в .env и поменяйте секреты для продакшена.
# Подпись JWT (не короче 32 символов)
JWT_SIGNING_KEY=change-me-please-very-long-random-secret-0123456789
# Пароли БД (совпадают с infra/postgres/01-init.sql для dev)
DB_APP_PASSWORD=dental_app
DB_OWNER_PASSWORD=dental_owner
POSTGRES_PASSWORD=postgres
# MinIO
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
# Окружение API: Development включает Scalar (/scalar) и Hangfire dashboard (/jobs у воркера)
ASPNETCORE_ENVIRONMENT=Development
# Регион хранения ПДн (законодательство РК)
STORAGE_REGION=kz-almaty-1
