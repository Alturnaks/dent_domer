@page
@model Dental.Web.Pages.RoleLimits.EditModalModel
@using Volo.Abp.AspNetCore.Mvc.UI.Bootstrap.TagHelpers.Modal
@{
    Layout = null;
}
<form asp-page="/RoleLimits/EditModal" method="post">
    <abp-modal>
        <abp-modal-header title="@L["RoleLimits:Edit", Model.RoleName].Value"></abp-modal-header>
        <abp-modal-body>
            <abp-input asp-for="RoleId" />
            <p class="text-muted small">@L["RoleLimits:EmptyMeansUnlimited"]</p>
            <abp-input asp-for="Limits.MaxDiscountPct" label="@L["RoleLimits:MaxDiscountPct"].Value" />
            <abp-input asp-for="Limits.MaxWriteoffTenge" label="@L["RoleLimits:MaxWriteoffAmount"].Value" />
            <abp-input asp-for="Limits.MaxRefundTenge" label="@L["RoleLimits:MaxRefundAmount"].Value" />
            <abp-input asp-for="Limits.CanEditClosedShiftVisits" label="@L["RoleLimits:CanEditClosedShiftVisits"].Value" />
        </abp-modal-body>
        <abp-modal-footer buttons="@(AbpModalButtons.Cancel | AbpModalButtons.Save)"></abp-modal-footer>
    </abp-modal>
</form>
