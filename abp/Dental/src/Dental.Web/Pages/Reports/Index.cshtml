@page
@model Dental.Web.Pages.Reports.IndexModel
@using Dental.Web.Menus
@{
    PageLayout.Content.Title = L["Menu:Reports"].Value;
    PageLayout.Content.MenuItemName = DentalMenus.Reports;
}
@section scripts { <abp-script src="/Pages/Schedule/calendar-date.js" /> <abp-script src="/Pages/Reports/Index.js" /> }
<abp-card><abp-card-body>
<form id="ReportFilter" class="row g-3 mb-4">
<div class="col-md-4"><label for="ReportCode" class="form-label">Отчёт</label><select id="ReportCode" class="form-select" required></select></div>
<div class="col-md-4"><label for="ReportBranch" class="form-label">Филиал</label><select id="ReportBranch" class="form-select"><option value="">Доступные филиалы</option></select></div>
<div class="col-md-2"><label for="ReportFrom" class="form-label">С</label><input id="ReportFrom" type="date" class="form-control" required /></div>
<div class="col-md-2"><label for="ReportTo" class="form-label">По</label><input id="ReportTo" type="date" class="form-control" required /></div>
<div class="col-md-2"><label for="ReportMonths" class="form-label">Неактивность, месяцев</label><input id="ReportMonths" type="number" min="1" max="120" value="6" class="form-control" required /></div>
<div class="col-md-10 d-flex flex-wrap align-items-end gap-2"><button type="submit" class="btn btn-primary">Показать</button><a id="ReportXlsx" class="btn btn-outline-primary">Excel</a><a id="ReportPdf" class="btn btn-outline-primary">PDF</a><a id="ReportCsv" class="btn btn-outline-secondary">CSV</a></div>
</form>
<p id="ReportState" role="status"></p><div id="ReportChart" class="mb-4" aria-label="График показателей"></div><div id="ReportTable" class="table-responsive"></div>
<hr /><h4>Ежедневные подписки</h4><p>Отчёт за текущий день доставляется по времени организации. Email требует настроенного SMTP; статус доставки виден в таблице.</p>
<form id="SubscriptionForm" class="d-flex flex-wrap gap-2 mb-3"><label for="SubscriptionTime" class="align-self-center">Время</label><input id="SubscriptionTime" type="time" value="21:00" class="form-control w-auto" required /><select id="SubscriptionChannel" class="form-select w-auto" aria-label="Канал доставки"><option value="internal">В приложении</option><option value="email">Email профиля</option></select><button type="submit" class="btn btn-outline-primary">Подписаться на выбранный отчёт</button></form><div id="Subscriptions" class="table-responsive"></div>
</abp-card-body></abp-card>
