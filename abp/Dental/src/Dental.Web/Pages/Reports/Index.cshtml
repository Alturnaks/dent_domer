@page
@model Dental.Web.Pages.Reports.IndexModel
@using Dental.Web.Menus
@{
    PageLayout.Content.Title = L["Menu:Reports"].Value;
    PageLayout.Content.MenuItemName = DentalMenus.Reports;
}
@section scripts { <abp-script src="/Pages/Schedule/calendar-date.js" /> <abp-script src="/Pages/Reports/Index.js" /> }
<abp-card><abp-card-body>
<form id="ReportFilter" class="row g-3 mb-4">
<div class="col-md-4"><label for="ReportCode" class="form-label">Отчёт</label><select id="ReportCode" class="form-select" required></select></div>
<div class="col-md-4"><label for="ReportBranch" class="form-label">Филиал</label><select id="ReportBranch" class="form-select"><option value="">Доступные филиалы</option></select></div>
<div class="col-md-4"><label for="ReportDoctor" class="form-label">Врач</label><select id="ReportDoctor" class="form-select"><option value="">Доступные врачи</option></select></div>
<div class="col-md-4"><label for="ReportGrouping" class="form-label">Группировка</label><select id="ReportGrouping" class="form-select"></select></div>
<div class="col-md-4"><label for="ReportPreset" class="form-label">Период</label><select id="ReportPreset" class="form-select"><option value="custom">Произвольный</option><option value="today">Сегодня</option><option value="week">Текущая неделя</option><option value="month" selected>Текущий месяц</option><option value="previousMonth">Прошлый месяц</option></select></div>
<div class="col-md-2"><label for="ReportFrom" class="form-label">С</label><input id="ReportFrom" type="date" class="form-control" required /></div>
<div class="col-md-2"><label for="ReportTo" class="form-label">По</label><input id="ReportTo" type="date" class="form-control" required /></div>
<div id="ReportMonthsField" class="col-md-2" hidden><label for="ReportMonths" class="form-label">Неактивность, месяцев</label><input id="ReportMonths" type="number" min="1" max="120" value="6" class="form-control" required disabled /></div>
<div class="col-md-10 d-flex flex-wrap align-items-end gap-2"><button type="submit" class="btn btn-primary">Показать</button><a id="ReportXlsx" class="btn btn-outline-primary">Excel</a><a id="ReportPdf" class="btn btn-outline-primary">PDF</a><a id="ReportCsv" class="btn btn-outline-secondary">CSV</a></div>
</form>
<div class="d-flex flex-wrap gap-2 mb-3"><input id="FilterName" class="form-control w-auto" maxlength="80" placeholder="Название фильтра" aria-label="Название сохраняемого фильтра" /><button id="SaveFilter" type="button" class="btn btn-outline-secondary">Сохранить фильтр</button><select id="SavedFilter" class="form-select w-auto" aria-label="Сохранённые фильтры"><option value="">Сохранённые фильтры</option></select><button id="DeleteFilter" type="button" class="btn btn-outline-danger">Удалить фильтр</button><button id="ReportBack" type="button" class="btn btn-outline-secondary" hidden>Назад к сводке</button></div>
<p id="ReportState" role="status"></p><div id="ReportChart" class="mb-4" aria-label="График показателей"></div><div id="ReportTable" class="table-responsive"></div>
<hr /><h4>Подписки на отчёты</h4><p>Ежедневно — данные текущего дня; еженедельно — последние семь дней. Доставка по времени организации. Email требует настроенного SMTP.</p>
<form id="SubscriptionForm" class="d-flex flex-wrap gap-2 mb-3"><select id="SubscriptionFrequency" class="form-select w-auto" aria-label="Частота"><option value="daily">Ежедневно</option><option value="weekly">Еженедельно</option></select><select id="SubscriptionWeekday" class="form-select w-auto" aria-label="День недели" hidden><option value="1">Понедельник</option><option value="2">Вторник</option><option value="3">Среда</option><option value="4">Четверг</option><option value="5">Пятница</option><option value="6">Суббота</option><option value="0">Воскресенье</option></select><label for="SubscriptionTime" class="align-self-center">Время</label><input id="SubscriptionTime" type="time" value="21:00" class="form-control w-auto" required /><select id="SubscriptionChannel" class="form-select w-auto" aria-label="Канал доставки"><option value="internal">В приложении</option><option value="email">Email профиля</option></select><button type="submit" class="btn btn-outline-primary">Подписаться на выбранный отчёт</button></form><div id="Subscriptions" class="table-responsive"></div>
</abp-card-body></abp-card>
