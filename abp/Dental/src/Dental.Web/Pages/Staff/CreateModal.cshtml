@page
@model Dental.Web.Pages.Staff.CreateModalModel
@using Volo.Abp.AspNetCore.Mvc.UI.Bootstrap.TagHelpers.Modal
@{
    Layout = null;
}
<form asp-page="/Staff/CreateModal" method="post">
    <abp-modal size="Large">
        <abp-modal-header title="@L["Employee:New"].Value"></abp-modal-header>
        <abp-modal-body>
            <partial name="_EmployeeForm" model="Model" />
        </abp-modal-body>
        <abp-modal-footer buttons="@(AbpModalButtons.Cancel | AbpModalButtons.Save)"></abp-modal-footer>
    </abp-modal>
</form>
