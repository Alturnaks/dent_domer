@model Dental.Patients.PatientDto
@using Microsoft.AspNetCore.Mvc.Localization
@using Dental.Localization
@inject IHtmlLocalizer<DentalResource> L
@* Точка расширения: модуль «Визиты» заменяет это представление историей визитов пациента (Model.Id). *@
<div class="text-muted py-3"><i class="fa fa-hourglass-half me-1"></i>@L["ComingSoon", L["Patient:Visits"].Value]</div>
