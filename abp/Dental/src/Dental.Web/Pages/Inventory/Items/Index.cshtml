@page
@model Dental.Web.Pages.Inventory.Items.IndexModel
@using Dental.Web.Menus
@{
    PageLayout.Content.Title = L["Inv:Items"].Value;
    PageLayout.Content.MenuItemName = DentalMenus.Inventory;
}
@section scripts {
    <abp-script src="/Pages/Inventory/inventory-common.js" />
    <abp-script src="/Pages/Inventory/Items/item-form.js" />
    <abp-script src="/Pages/Inventory/Items/Index.js" />
}
<partial name="_InventoryNav" model="@("items")" />
<abp-card>
    <abp-card-header>
        <abp-row>
            <abp-column size-md="_6"><abp-card-title>@L["Inv:Items"]</abp-card-title></abp-column>
            <abp-column size-md="_6" class="text-end">
                @if (Model.CanManage)
                {
                    <abp-button id="NewItemButton" text="@L["Inv:NewItem"].Value" icon="plus" button-type="Primary" />
                }
            </abp-column>
        </abp-row>
    </abp-card-header>
    <abp-card-body>
        <div class="row g-2 mb-3" id="ItemsFilters" data-can-manage="@Model.CanManage.ToString().ToLower()">
            <div class="col-md-4"><input id="FFilter" class="form-control" placeholder="@L["Search"]" /></div>
            <div class="col-md-4"><select id="FCategory" class="form-select"></select></div>
            <div class="col-md-3 pt-2"><div class="form-check"><input type="checkbox" class="form-check-input" id="FInactive" /><label class="form-check-label" for="FInactive">@L["Inv:ShowInactive"]</label></div></div>
        </div>
        <abp-table striped-rows="true" id="ItemsTable"></abp-table>
    </abp-card-body>
</abp-card>
