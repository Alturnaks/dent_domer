@using Microsoft.AspNetCore.Mvc.Localization
@using Dental.Localization
@inject IHtmlLocalizer<DentalResource> L
<div class="dropdown dental-notifications me-2" id="DentalNotifications">
    <a href="#" class="nav-link position-relative px-2" data-bs-toggle="dropdown" aria-expanded="false" title="@L["Notifications"]">
        <i class="fa fa-bell"></i>
        <span class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-danger d-none" data-role="count">0</span>
    </a>
    <div class="dropdown-menu dropdown-menu-end shadow p-0" style="width: 360px">
        <div class="d-flex justify-content-between align-items-center px-3 py-2 border-bottom">
            <strong>@L["Notifications"]</strong>
            <a href="#" class="small" data-role="read-all">@L["Notifications:MarkAllRead"]</a>
        </div>
        <div data-role="list" style="max-height: 400px; overflow-y: auto">
            <div class="text-muted small px-3 py-3">@L["Notifications:Empty"]</div>
        </div>
    </div>
</div>
